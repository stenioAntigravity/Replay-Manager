<UserControl x:Class="ReplayManager.App.Views.UploadQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ReplayManager.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#121212">

    <UserControl.Resources>
        <conv:ImagePathToBitmapConverter x:Key="ImagePathConverter" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383838" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Cabeçalho da Fila e Controles Globais -->
            <RowDefinition Height="Auto" />
            <!-- Lista de Itens -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Ações Superior -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="6" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fila de Upload para o YouTube" FontSize="18" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Processamento sequencial resiliente (1 vídeo por vez). Suporte a retomada automática." Foreground="#888888" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Taxa de Transferência:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock Text="{Binding BandwidthLimitDisplay}" Foreground="#1E88E5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" />
                    <Button Content="🔄 Atualizar Fila" Style="{StaticResource ActionButtonStyle}" Command="{Binding LoadQueueCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Estado Vazio -->
        <Border Grid.Row="1" Background="#181818" CornerRadius="6"
                Visibility="{Binding Items.Count, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=0, FallbackValue=Collapsed}">
            <!-- Tratado pelo ListView abaixo -->
        </Border>

        <!-- Lista de Uploads -->
        <ListView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  Background="#181818" BorderThickness="0" Foreground="White">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="#202020" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Miniatura -->
                            <ColumnDefinition Width="120" />
                            <!-- Detalhes e Progresso -->
                            <ColumnDefinition Width="*" />
                            <!-- Ações -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" Height="68" CornerRadius="4" Background="#111111" Margin="0,0,14,0">
                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Informações do Vídeo & Barra de Progresso -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#1E88E5" FontWeight="Bold" FontSize="12" />
                            </Grid>

                            <!-- Barra de Progresso -->
                            <ProgressBar Height="6" Margin="0,8,0,6" Minimum="0" Maximum="100" Value="{Binding Percentage}" Foreground="#1E88E5" Background="#333333" BorderThickness="0" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding FormattedUploadedSize}" Foreground="#AAAAAA" FontSize="11" />
                                    <TextBlock Text=" / " Foreground="#666666" FontSize="11" />
                                    <TextBlock Text="{Binding FormattedTotalSize}" Foreground="#AAAAAA" FontSize="11" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding FormattedSpeed}" Foreground="#00E676" FontSize="11" HorizontalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat={}{0:F1}%}" Foreground="#EEEEEE" FontWeight="Bold" FontSize="11" />
                            </Grid>

                            <TextBlock Text="{Binding LastError}" Foreground="#EF5350" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding LastError, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=HasError, FallbackValue=Collapsed}" />
                        </StackPanel>

                        <!-- Ações do Item -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⬆" ToolTip="Subir Prioridade" Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="⬇" ToolTip="Descer Prioridade" Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="⏸ Pausar" Style="{StaticResource ActionButtonStyle}" IsEnabled="{Binding CanPause}"
                                    Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="▶ Retomar" Style="{StaticResource ActionButtonStyle}" IsEnabled="{Binding CanResume}"
                                    Command="{Binding DataContext.ResumeItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="❌ Cancelar" Style="{StaticResource ActionButtonStyle}" IsEnabled="{Binding CanCancel}"
                                    Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
