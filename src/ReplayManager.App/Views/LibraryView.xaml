<UserControl x:Class="ReplayManager.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReplayManager.App.Views"
             xmlns:vm="clr-namespace:ReplayManager.App.ViewModels"
             xmlns:conv="clr-namespace:ReplayManager.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolConverter" />
        <conv:ImagePathToBitmapConverter x:Key="ImagePathConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Estilos de Cores Modernas Dark Theme -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0D0E12" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#16181F" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1F232D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#282C37" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E929E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="ConnectedGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="PendingOrangeBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="YouTubeTealBrush" Color="#06B6D4" />

        <!-- Estilo de Botão de Link Rápido -->
        <Style x:Key="LinkActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" 
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="None"
                                   Cursor="Hand">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#38BDF8" />
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio Button Pill de Filtro -->
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1A1D26" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderBrush" Value="#2D3240" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262B38" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <!-- Cabeçalho com Métricas e Barra de Busca/Filtros -->
            <RowDefinition Height="Auto" />
            <!-- Conteúdo Principal: Grade de Vídeos e Painel de Detalhes -->
            <RowDefinition Height="*" />
            <!-- Barra Inferior de Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Cabeçalho de Alta Fidelidade (Mockup) -->
        <Border Grid.Row="0" Background="#111319" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18,24,16">
            <StackPanel>
                <!-- Linha 1: Título e Status de Conexão com YouTube -->
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="Replay Manager" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />

                    <!-- Badge de Conexão com YouTube -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Conectado -->
                        <Border Background="#163828" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsYouTubeConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Conectado" Foreground="#34D399" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <!-- Desconectado -->
                        <Border Background="#2D1A1A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsYouTubeConnected}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Desconectado" Foreground="#F87171" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Botão Atualizar Geral -->
                        <Button Command="{Binding LoadVideosCommand}"
                                Background="#1E222D"
                                Foreground="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="12,5"
                                Cursor="Hand">
                            <TextBlock Text="🔄 Atualizar" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Linha 2: Contadores em Grade / Cards Informativos -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Total de Vídeos -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TotalVideosCount}" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Vídeos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- No YouTube -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding UploadedVideosCount}" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="No YouTube" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Na fila -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding QueuedVideosCount}" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Na fila" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Linha 3: Barra de Pesquisa e Filtros Rápidos -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input de Pesquisa -->
                    <Border Grid.Column="0" Background="#181B24" CornerRadius="8" BorderBrush="#2D3240" BorderThickness="1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     FontSize="13" />
                            <TextBlock Grid.Column="1"
                                       Text="Pesquisar vídeos..."
                                       Foreground="#525866"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Limpar busca se tiver texto -->
                            <Button Grid.Column="2"
                                    Command="{Binding DataContext.ClearSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="4,0"
                                    Content="✕"
                                    Visibility="{Binding SearchText.Length, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}" />
                        </Grid>
                    </Border>

                    <!-- Botões de Filtros em Formato Pill -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🏷️" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                        <RadioButton Style="{StaticResource FilterPillStyle}" Content="Todos"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource FilterPillStyle}" Content="⭐ Favoritos"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Favorites}" />
                        <RadioButton Style="{StaticResource FilterPillStyle}" Content="Apenas Local"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=OnlyLocal}" />
                        <RadioButton Style="{StaticResource FilterPillStyle}" Content="No YouTube"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Uploaded}" />
                        <RadioButton Style="{StaticResource FilterPillStyle}" Content="Na Fila"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Queued}" />
                        <RadioButton Style="{StaticResource FilterPillStyle}" Content="Arquivo Ausente"
                                     IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MissingFile}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Grade de Vídeos + Painel Lateral de Detalhes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Grade de Cartões de Vídeo -->
                <ColumnDefinition Width="*" />
                <!-- Painel Lateral de Detalhes -->
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <!-- Estado Vazio quando não há nenhum vídeo -->
                <Border Background="Transparent" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredVideos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#4A5060" />
                        <TextBlock Text="Nenhum vídeo encontrado" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Adicione uma pasta para importar seus replays existentes ou verifique se os filtros aplicados não estão restringindo os resultados." 
                                   Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,24" />
                        <Button Command="{Binding GoToMonitoredFoldersCommand}" 
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Padding="20,12" FontSize="14" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Center">
                            <TextBlock Text="📁 Gerenciar Pastas Monitoradas" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Grade Virtualizada de Vídeos -->
                <ListBox ItemsSource="{Binding FilteredVideos}" 
                         SelectedItem="{Binding SelectedVideo}"
                         Background="Transparent" 
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Padding="20">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredVideos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="10" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <EventSetter Event="MouseDoubleClick" Handler="OnListBoxItemMouseDoubleClick" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Container com RenderTransform para efeito de levitação suave (Hover Motion) -->
                                        <Border x:Name="ItemBorder" 
                                                CornerRadius="10" 
                                                Background="{StaticResource CardBgBrush}" 
                                                BorderBrush="{StaticResource BorderBrush}" 
                                                BorderThickness="1" 
                                                Width="320" 
                                                Cursor="Hand"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="ScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                                                    <TranslateTransform x:Name="TranslateTransform" Y="0" />
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4B5563" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15" />
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15" />
                                                            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15" />
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15" />
                                                            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5" />
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1C2230" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VideoCardViewModel}">
                            <Grid Width="320">
                                <Grid.RowDefinitions>
                                    <!-- Thumbnail 16:9 proporção (largura 320 -> altura 180) -->
                                    <RowDefinition Height="180" />
                                    <!-- Informações e Ações do Cartão -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Miniatura com Bordas Arredondadas Superiores -->
                                <Border Grid.Row="0" Background="#0A0B0E" CornerRadius="9,9,0,0" ClipToBounds="True">
                                    <Grid>
                                        <!-- Imagem real gerada -->
                                        <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImagePathConverter}}" 
                                               Stretch="UniformToFill" />

                                        <!-- Placeholder se thumbnail não existir -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThumbnailPath}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="🎬" FontSize="44" Foreground="#333846" HorizontalAlignment="Center" />
                                            <TextBlock Text="Sem miniatura" FontSize="11" Foreground="#666E80" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Botão Favorito / Bandeira no canto superior direito -->
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                ToolTip="Adicionar / Remover dos Favoritos">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="FavBorder"
                                                            Background="#B0000000"
                                                            CornerRadius="14"
                                                            Width="28" Height="28">
                                                        <TextBlock x:Name="FavIcon"
                                                                   Text="{Binding IsFavorite, Converter={x:Null}, FallbackValue='☆'}"
                                                                   Foreground="#D1D5DB"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter TargetName="FavIcon" Property="Text" Value="🚩" />
                                                            <Setter TargetName="FavIcon" Property="Foreground" Value="#EF4444" />
                                                            <Setter TargetName="FavBorder" Property="Background" Value="#E0111827" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                                                            <Setter TargetName="FavIcon" Property="Text" Value="⚐" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FavBorder" Property="Background" Value="#E51F2937" />
                                                            <Setter TargetName="FavIcon" Property="Foreground" Value="#F59E0B" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Duração no canto inferior direito -->
                                        <Border Background="#D0000000" CornerRadius="4" Padding="6,2" 
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                            <TextBlock Text="{Binding FormattedDuration}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Área Inferior de Informações -->
                                <Border Grid.Row="1" Padding="14,12,14,14">
                                    <StackPanel>
                                        <!-- Título do Vídeo (ex: Replay 30-10-2026 ou customizado) -->
                                        <TextBlock Text="{Binding DisplayTitle}" 
                                                   Foreground="White" 
                                                   FontWeight="Bold" 
                                                   FontSize="14" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding DisplayTitle}" />

                                        <!-- Horário de Gravação • Duração (ex: 12:45 • 08:32) -->
                                        <TextBlock Margin="0,4,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                            <Run Text="{Binding RecordedTimeFormatted, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding FormattedDuration, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Badges: Local (verde), YouTube (ciano), Pendente (laranja) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <!-- Badge Local -->
                                            <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#173B28" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLocalFile}" Value="False">
                                                                <Setter Property="Background" Value="#3B1818" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Local" />
                                                            <Setter Property="Foreground" Value="#34D399" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLocalFile}" Value="False">
                                                                    <Setter Property="Text" Value="Ausente" />
                                                                    <Setter Property="Foreground" Value="#F87171" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Badge YouTube se já enviado -->
                                            <Border Background="#163745" CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                    Visibility="{Binding HasYouTubeVideo, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="YouTube" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" />
                                            </Border>

                                            <!-- Badge Pendente / Na Fila se não estiver concluído nem ausente -->
                                            <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UploadStatus}" Value="Queued">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Background" Value="#382913" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding UploadStatus}" Value="Uploading">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Background" Value="#382913" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Pendente" Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Ações de Navegação e Reprodução em Linha (Ex: "Abrir local • YouTube" ou "Abrir local • Aguardando envio") -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Link "Abrir local" -->
                                                <Button Style="{StaticResource LinkActionButtonStyle}"
                                                        Content="Abrir local"
                                                        Command="{Binding DataContext.OpenLocalVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding HasLocalFile}"
                                                        ToolTip="Reproduzir arquivo local" />

                                                <TextBlock Text=" • " Foreground="#6B7280" VerticalAlignment="Center" Margin="2,0" />

                                                <!-- Link "YouTube" (se já enviado) -->
                                                <Button Style="{StaticResource LinkActionButtonStyle}"
                                                        Content="YouTube"
                                                        Command="{Binding DataContext.OpenYouTubeLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasYouTubeVideo, Converter={StaticResource BoolToVisConverter}}"
                                                        ToolTip="Assistir no YouTube" />

                                                <!-- Ou texto informativo de status se ainda não tiver no YouTube -->
                                                <TextBlock Foreground="#6B7280" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasYouTubeVideo}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UploadStatus}" Value="Queued">
                                                                    <Setter Property="Text" Value="Aguardando envio" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UploadStatus}" Value="Uploading">
                                                                    <Setter Property="Text" Value="Enviando..." />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UploadStatus}" Value="None">
                                                                    <Setter Property="Text" Value="Não enviado" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UploadStatus}" Value="Failed">
                                                                    <Setter Property="Text" Value="Falha no envio" />
                                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Botão de Copiar Link do YouTube -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.CopyYouTubeLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#9CA3AF"
                                                    Padding="4,2"
                                                    Cursor="Hand"
                                                    Visibility="{Binding HasYouTubeVideo, Converter={StaticResource BoolToVisConverter}}"
                                                    ToolTip="Copiar link do YouTube">
                                                <TextBlock Text="📋 Copiar" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 3. Painel Lateral de Detalhes -->
            <Border Grid.Column="1" Background="#13151D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Cabeçalho -->
                        <TextBlock Text="Detalhes do Replay" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                        <!-- Mensagem quando nenhum vídeo está selecionado -->
                        <TextBlock Text="Selecione um vídeo da grade para visualizar, editar detalhes ou gerenciar o envio para o YouTube." 
                                   Foreground="#6B7280" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedVideo}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Conteúdo quando há vídeo selecionado -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedVideo}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Miniatura ampliada -->
                            <Border CornerRadius="8" ClipToBounds="True" Background="#0A0B0E" Height="190" BorderBrush="#2D3240" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding SelectedVideo.ThumbnailPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                    <!-- Botão Alterar Miniatura sobreposto -->
                                    <Button Command="{Binding ChangeThumbnailCommand}" 
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                            Background="#DD111319" Foreground="White" BorderBrush="#4B5563" Padding="10,5" FontSize="11" Cursor="Hand">
                                        <TextBlock Text="📷 Alterar Miniatura" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Ações Rápidas: Reproduzir (Inteligente) e Enfileirar -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                        Command="{Binding PlayVideoCommand}"
                                        Background="#10B981" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Padding="10,9" 
                                        FontWeight="SemiBold" 
                                        Cursor="Hand">
                                    <TextBlock Text="▶ Reproduzir" />
                                </Button>

                                <Button Grid.Column="2" 
                                        Command="{Binding EnqueueForUploadCommand}"
                                        Background="#2563EB" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Padding="10,9" 
                                        FontWeight="SemiBold" 
                                        Cursor="Hand">
                                    <TextBlock Text="🚀 Enviar p/ YouTube" />
                                </Button>
                            </Grid>

                            <!-- Metadados Técnicos em Grade Compacta -->
                            <Border Background="#1A1D26" CornerRadius="6" Padding="14" Margin="0,14,0,0" BorderBrush="#282C37" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Arquivo:" Foreground="#888888" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedVideo.FileName}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolução:" Foreground="#888888" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVideo.FormattedResolution}" Foreground="White" FontSize="11" Margin="0,3" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Duração:" Foreground="#888888" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVideo.FormattedDuration}" Foreground="White" FontSize="11" Margin="0,3" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tamanho:" Foreground="#888888" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVideo.FormattedFileSize}" Foreground="White" FontSize="11" Margin="0,3" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Gravado em:" Foreground="#888888" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVideo.FormattedRecordedAt}" Foreground="White" FontSize="11" Margin="0,3" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="YouTube URL:" Foreground="#888888" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedVideo.YouTubeUrl, FallbackValue='Não disponível'}" Foreground="#38BDF8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3" />
                                </Grid>
                            </Border>

                            <!-- Formulário de Edição YouTube -->
                            <TextBlock Text="Título no YouTube" Foreground="#D1D5DB" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,4" />
                            <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E222D" Foreground="White" BorderBrush="#2D3240" Padding="8,6" FontSize="13" />

                            <TextBlock Text="Descrição" Foreground="#D1D5DB" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4" />
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E222D" Foreground="White" BorderBrush="#2D3240" Padding="8,6" FontSize="12"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />

                            <Button Command="{Binding SaveMetadataChangesCommand}" 
                                    Margin="0,14,0,0" 
                                    Background="#374151" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Padding="10,8" 
                                    FontWeight="SemiBold" 
                                    Cursor="Hand">
                                <TextBlock Text="💾 Salvar Alterações" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Barra Inferior de Status -->
        <Border Grid.Row="2" Background="#0C0D11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#8E929E" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
