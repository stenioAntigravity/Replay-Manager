<UserControl x:Class="ReplayManager.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReplayManager.App.Views"
             xmlns:vm="clr-namespace:ReplayManager.App.ViewModels"
             xmlns:conv="clr-namespace:ReplayManager.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolConverter" />
        <conv:ImagePathToBitmapConverter x:Key="ImagePathConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Estilos de Cores Modernas Dark Theme -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#121212" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1E88E5" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <!-- Barra Superior: Busca, Filtros e Ações -->
            <RowDefinition Height="Auto" />
            <!-- Conteúdo Principal: Grade Virtualizada e Painel Lateral -->
            <RowDefinition Height="*" />
            <!-- Barra Inferior de Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Barra Superior de Controle -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Campo de Busca -->
                <Border Grid.Column="0" Background="#262626" CornerRadius="4" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" 
                                 Foreground="White" 
                                 BorderThickness="0" 
                                 VerticalAlignment="Center" 
                                 FontSize="13" />
                    </Grid>
                </Border>

                <!-- Filtros de Status (RadioButtons estilizados) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <RadioButton Content="Todos" Margin="0,0,12,0" Foreground="White"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All}" />
                    <RadioButton Content="Apenas Local" Margin="0,0,12,0" Foreground="#64B5F6"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=OnlyLocal}" />
                    <RadioButton Content="Na Fila" Margin="0,0,12,0" Foreground="#FFF176"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Queued}" />
                    <RadioButton Content="Enviados" Margin="0,0,12,0" Foreground="#81C784"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Uploaded}" />
                    <RadioButton Content="Arquivo Ausente" Margin="0,0,12,0" Foreground="#E57373"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MissingFile}" />
                </StackPanel>

                <!-- Botão Recarregar -->
                <Button Grid.Column="2" 
                        Command="{Binding LoadVideosCommand}" 
                        Background="#2D2D2D" 
                        Foreground="White" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        Padding="14,6" 
                        Cursor="Hand">
                    <TextBlock Text="🔄 Atualizar" />
                </Button>
            </Grid>
        </Border>

        <!-- 2. Grade de Vídeos + Painel Lateral de Detalhes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Grade Virtualizada de Miniaturas -->
                <ColumnDefinition Width="*" />
                <!-- Painel Lateral de Detalhes -->
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Lista / Grade Virtualizada com VirtualizingStackPanel / UniformGrid -->
            <ListBox Grid.Column="0" 
                     ItemsSource="{Binding FilteredVideos}" 
                     SelectedItem="{Binding SelectedVideo}"
                     Background="Transparent" 
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Padding="16">
                
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" 
                                            CornerRadius="6" 
                                            Background="{StaticResource CardBgBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" 
                                            BorderThickness="1" 
                                            Width="240" 
                                            Height="210"
                                            Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#555555" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VideoCardViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Thumbnail e badges -->
                                <RowDefinition Height="135" />
                                <!-- Título e metadados rápidos -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Imagem da miniatura com fallback -->
                            <Border Grid.Row="0" Background="#111111" CornerRadius="5,5,0,0" ClipToBounds="True">
                                <Grid>
                                    <!-- Imagem real -->
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImagePathConverter}}" 
                                           Stretch="UniformToFill" />

                                    <!-- Placeholder quando não tem thumbnail -->
                                    <TextBlock Text="🎬" FontSize="40" Foreground="#444444" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThumbnailPath}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Duração sobreposta no canto inferior direito -->
                                    <Border Background="#CC000000" CornerRadius="3" Padding="5,2" 
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                        <TextBlock Text="{Binding FormattedDuration}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Badge de Status no canto superior esquerdo -->
                                    <Border Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="6,2" 
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                        <TextBlock Text="{Binding StatusBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Informações do Vídeo -->
                            <StackPanel Grid.Row="1" Margin="10,8,10,6">
                                <TextBlock Text="{Binding DisplayTitle}" 
                                           Foreground="White" 
                                           FontWeight="SemiBold" 
                                           FontSize="13" 
                                           TextTrimming="CharacterEllipsis" 
                                           ToolTip="{Binding DisplayTitle}" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FormattedRecordedAt}" Foreground="#888888" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedFileSize}" Foreground="#888888" FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 3. Painel Lateral de Detalhes -->
            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Cabeçalho -->
                        <TextBlock Text="Detalhes do Replay" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                        <!-- Mensagem quando nenhum vídeo está selecionado -->
                        <TextBlock Text="Selecione um vídeo da grade para visualizar e editar os detalhes." 
                                   Foreground="#777777" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedVideo}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Conteúdo quando há vídeo selecionado -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedVideo}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Miniatura ampliada -->
                            <Border CornerRadius="6" ClipToBounds="True" Background="#111111" Height="170" BorderBrush="#333333" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding SelectedVideo.ThumbnailPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                    <!-- Botão Alterar Miniatura sobreposto -->
                                    <Button Command="{Binding ChangeThumbnailCommand}" 
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                            Background="#DD000000" Foreground="White" BorderBrush="#666666" Padding="8,4" FontSize="11" Cursor="Hand">
                                        <TextBlock Text="📷 Alterar Miniatura" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Ações Rápidas: Reproduzir e Enfileirar -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                        Command="{Binding PlayVideoCommand}"
                                        Background="#2E7D32" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Padding="10,8" 
                                        FontWeight="SemiBold" 
                                        Cursor="Hand">
                                    <TextBlock Text="▶ Reproduzir (VLC)" />
                                </Button>

                                <Button Grid.Column="2" 
                                        Command="{Binding EnqueueForUploadCommand}"
                                        Background="#1565C0" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Padding="10,8" 
                                        FontWeight="SemiBold" 
                                        Cursor="Hand">
                                    <TextBlock Text="🚀 Enviar p/ YouTube" />
                                </Button>
                            </Grid>

                            <!-- Metadados Técnicos em Grade Compacta -->
                            <Border Background="#222222" CornerRadius="4" Padding="12" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Arquivo:" Foreground="#888888" FontSize="11" Margin="0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedVideo.FileName}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolução:" Foreground="#888888" FontSize="11" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVideo.FormattedResolution}" Foreground="White" FontSize="11" Margin="0,2" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Duração:" Foreground="#888888" FontSize="11" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVideo.FormattedDuration}" Foreground="White" FontSize="11" Margin="0,2" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tamanho:" Foreground="#888888" FontSize="11" Margin="0,2" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVideo.FormattedFileSize}" Foreground="White" FontSize="11" Margin="0,2" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Gravado em:" Foreground="#888888" FontSize="11" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVideo.FormattedRecordedAt}" Foreground="White" FontSize="11" Margin="0,2" />
                                </Grid>
                            </Border>

                            <!-- Formulário de Edição YouTube -->
                            <TextBlock Text="Título no YouTube" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,4" />
                            <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#262626" Foreground="White" BorderBrush="#3A3A3A" Padding="8,6" FontSize="13" />

                            <TextBlock Text="Descrição" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4" />
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#262626" Foreground="White" BorderBrush="#3A3A3A" Padding="8,6" FontSize="12"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />

                            <Button Command="{Binding SaveMetadataChangesCommand}" 
                                    Margin="0,14,0,0" 
                                    Background="#424242" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Padding="10,8" 
                                    FontWeight="SemiBold" 
                                    Cursor="Hand">
                                <TextBlock Text="💾 Salvar Alterações" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Barra Inferior de Status -->
        <Border Grid.Row="2" Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" FontSize="12" />
        </Border>
    </Grid>
</UserControl>

