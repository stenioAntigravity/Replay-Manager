<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Default publish settings for portable build -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Ensure native files are copied -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Include FFmpeg binaries placed under tools/ffmpeg -->
    <None Include="..\..\tools\ffmpeg\**\*.*" Link="tools\ffmpeg\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReplayManager.Domain\ReplayManager.Domain.csproj" />
    <ProjectReference Include="..\ReplayManager.Application\ReplayManager.Application.csproj" />
    <ProjectReference Include="..\ReplayManager.Infrastructure\ReplayManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    
    <StartupObject>ReplayManager.App.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
